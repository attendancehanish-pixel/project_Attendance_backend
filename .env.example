DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
PORT=4000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# Mobile app login lifetime (sliding - renewed every time the app refreshes)
MOBILE_REFRESH_TOKEN_DAYS=30
PASSWORD_RESET_MINUTES=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com

# Application/business timezone
APP_TIMEZONE=Asia/Kolkata
TZ=Asia/Kolkata

# REAL for production. MOCK is development/testing only.
TIME_MODE=REAL
# MOCK_NOW=2026-10-05T09:15:00+05:30
